# Bu değerleri dosyaya değil, barındırma sağlayıcının "secret / environment variable" bölümüne gir.
PORT=3000
# Pi Developers > uygulama > Settings > API key > Generate new key  (ödemeler ve bildirimler için)
PI_NETWORK_API_KEY=
# Alan adı doğrulamasında (verify_app_url_ownership) verilen anahtar
PI_VALIDATION_KEY=
# Uygulamanın Pi Browser adresi; davet linkleri bununla oluşur (ör. https://pibilardo1234.pinet.com)
PI_APP_URL=
# Yalnızca geliştirme: Pi girişi olmadan çevrimiçi odayı iki tarayıcıda denemek için 1 yap. Canlıda KAPALI tut.
ALLOW_GUEST=0
# Kalıcı disk yolu (isteğe bağlı)
DB_FILE=./data.json
